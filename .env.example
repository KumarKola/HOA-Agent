# Postgres connection string (Supabase > Project Settings > Database > Connection string, "Transaction pooler").
# Leave empty for local development: an embedded database is stored in ./.data
DATABASE_URL=

# Passcode for the volunteer liaison page (/admin). Pick something long.
ADMIN_PASSCODE=

# Random string used to hash reporter IP addresses for spam limits (never stored raw).
HASH_SALT=

# Email via Resend (resend.com). Without a key, emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM="Liberty Gates <gates@your-domain.com>"
MANAGER_EMAIL=          # City Property community manager
LIAISON_EMAIL=          # volunteer liaison, copied on new incidents
PRESIDENT_EMAIL=        # HOA president, receives 48-hour escalations
BOARD_EMAILS=           # comma-separated, receives the monthly summary

# Public URL of the site, used in email links
SITE_URL=https://liberty-gates.vercel.app

# Vercel sets this header on cron calls; set any random string
CRON_SECRET=
